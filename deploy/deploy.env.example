# deploy.env — Per-app configuration for AWS deploy scripts
# Copy to deploy/deploy.env and edit for your project.

# === Required ===
REPO_URL=https://github.com/dtcc-platform/dtcc-data.git
REPO_BRANCH=main

# === AWS ===
AWS_REGION=eu-north-1
INSTANCE_TYPE=t3.medium
EBS_VOLUME_SIZE=100
KEY_NAME=dtcc-data-key
PROJECT_NAME=dtcc-data
SG_PORTS="22 8001"           # Space-separated inbound TCP ports

# === App ===
APP_NAME=dtcc-data            # Systemd service name + clone dir
FASTAPI_MODULE=server:app     # uvicorn module
FASTAPI_PORT=8001
WORK_DIR=src                  # Relative to repo root
PYTHON_EXTRAS=".[test]"       # pip install extras

# === Optional: Extra repos (cloned + installed before main app) ===
EXTRA_REPOS=""                # Space-separated "url@branch" pairs
                              # Example: "https://github.com/org/lib.git@main"

# === Optional: Conda (for packages unavailable via pip) ===
CONDA_PACKAGES=""             # Space-separated conda-forge packages. Empty = uv-only.
                              # Example: "fenics-dolfinx mpich pyvista"

# === Optional: S3 ===
S3_BUCKET=                    # Empty = no S3 access, no IAM role
S3_LAZ_PREFIX=laz/
S3_REGION=eu-north-1

# === Optional: PostgreSQL ===
DB_NAME=                      # Empty = skip DB setup entirely
DB_USER=dtcc
DB_PASS=dtcc

# === Optional: Systemd extra env vars (one per line) ===
SYSTEMD_ENV="
PYTHONPATH=/home/ubuntu/dtcc-data/src
"

# === Optional: Post-setup script (runs after base setup, before systemd start) ===
POST_SETUP_SCRIPT=deploy/post-setup-dtcc-data.sh
